# Copy to .env and fill in. docker compose reads this file automatically.
# Everything has a working default for local development except the LLM API keys.

# --- Core ---
# DATABASE_URL is set by docker-compose.yml for the api service. Set it here only when
# running the API outside Docker:
# DATABASE_URL=postgresql+asyncpg://immersion:immersion@localhost:5432/immersion

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The origin the browser loads the web app from.
CORS_ORIGIN=http://localhost:3000

# Set to true when serving over https.
COOKIE_SECURE=false

# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM: conversation partner (Google Gemini, OpenAI-compatible endpoint) ---
# Key: https://aistudio.google.com/apikey
LLM_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=gemini-3.8-flash
# LLM_CHAT_REASONING_EFFORT=low

# --- LLM: error analysis, wrap-up, hints (Groq) ---
# Key: https://console.groq.com/keys
LLM_ANALYSIS_BASE_URL=https://api.groq.com/openai/v1
LLM_ANALYSIS_API_KEY=
LLM_ANALYSIS_MODEL=openai/gpt-oss-20b
# LLM_ANALYSIS_REASONING_EFFORT=low

# --- LLM: optional fallback, used when the main provider is rate limited or down ---
# Local Ollama (private, no quota). Inside Docker, reach the host via host.docker.internal.
# LLM_FALLBACK_BASE_URL=http://host.docker.internal:11434/v1
# LLM_FALLBACK_API_KEY=ollama
# LLM_FALLBACK_MODEL=llama3.2

# --- LLM: optional tuning (defaults shown) ---
# LLM_DAILY_REQUEST_BUDGET=1000      # soft cap: warns at 80% and 100%
# LLM_TIMEOUT_SECONDS=30             # per request and per gap between streamed chunks
# LLM_MAX_RETRIES=2                  # retries on 429/5xx before switching provider
# LLM_HISTORY_TURNS=20               # turns of history sent with each reply
# LLM_CHAT_MAX_TOKENS=1024           # also LLM_ANALYSIS_ / LLM_FALLBACK_
# LLM_CHAT_JSON_MODE=false           # native JSON mode, only for providers that support it

# Copy to .env and fill in. docker compose reads this file automatically.
# Everything has a working default for local development except the LLM keys (Phase 2+).

# --- Core ---
# DATABASE_URL is set by docker-compose.yml for the api service. Set it here only when
# running the API outside Docker:
# DATABASE_URL=postgresql+asyncpg://immersion:immersion@localhost:5432/immersion

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The origin the browser loads the web app from.
CORS_ORIGIN=http://localhost:3000

# Set to true when serving over https.
COOKIE_SECURE=false

# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
